# Copy this file to ".env" and fill in your values, OR set these as real
# environment variables before starting the server.

# Which TV protocol to use:
#   ws     -> modern Tizen TVs (2016+), e.g. "Samsung 8 Series (65)"
#   legacy -> older TVs (2012-2015), e.g. UA46ES6200
TV_METHOD=ws

# Your TV's IP address on your home network.
# Find it on the TV: Settings -> General -> Network -> Network Status -> IP Settings
# (or check your router's list of connected devices).
TV_HOST=192.168.1.50

# Port. Defaults are sensible per method, override only if needed:
#   ws     -> 8002 (encrypted, recommended) or 8001
#   legacy -> 55000
# TV_PORT=8002

# Name shown on the TV when it asks you to authorize this remote (ws only).
TV_NAME=HomeVolumeControl

# Where to store the pairing token for modern TVs (ws only) so you only
# authorize once. Keep this path writable.
TV_TOKEN_FILE=./tv_token.txt

# REQUIRED if you expose this service beyond your LAN.
# Any request must send this key (header "X-API-Key" or "?key=").
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(24))"
# Leave blank ONLY for local-network-only testing.
API_KEY=

# How many volume steps the "panic" button drops at once.
PANIC_STEPS=5
